<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app uses its warm light palette even when the OS is in dark mode. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/mc_splash_background</item>
        <item name="android:navigationBarColor">@color/mc_splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/mc_splash_background</item>
    </style>
</resources>
