<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/mc_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/mc_splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">180</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/mc_splash_background</item>
        <item name="android:navigationBarColor">@color/mc_splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/mc_splash_background</item>
    </style>
</resources>
